{
    "id": "fg_posts_layer",
    "type": "symbol",
    "source": "fg_posts_source",
    "minzoom": 8,
    "filter": [
        "!=",
        ["get", "selected"],
        true
    ],
    "layout": {
        "icon-image": ["get", "icon"],
        "icon-allow-overlap": true,
        "icon-ignore-placement": true,
        "icon-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            8, 0.28,
            9, 0.30,
            10.5, 0.33,
            12, 0.37,
            13, 0.42,
            14, 0.47,
            15, 0.52,
            16, 0.56,
            22, 0.56
        ],
        "icon-opacity": 1
    }
}
